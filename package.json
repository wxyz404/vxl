{
  "name": "vxl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "models:setup": "node scripts/setup-models.mjs",
    "postinstall": "node scripts/setup-models.mjs --runtime-only",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "compare:outlines": "node scripts/compare-outlines.mjs",
    "compare:depth": "node scripts/compare-depth.mjs",
    "compare:palettes": "node scripts/compare-palette-mapping.mjs",
    "compare:faces": "node scripts/compare-faces.mjs",
    "benchmark:faces": "node scripts/benchmark-faces.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
